//------------------------------------------------
//--- 010 Editor Binary Template
//
//      File: spyro_sfx_projectdetails.bt
//   Purpose: Parse EuroSound __ProjectDetails.SFX files generated by EuroSoundRedux.
// File Mask: __projectdetails.sfx
//  ID Bytes: 4D 55 53 58
//------------------------------------------------

LittleEndian();

typedef struct
{
    char Magic[4];
    uint Hashcode <format=hex>;
    uint FileVersion;
    uint FileSize <format=hex>;
    char Platform[4];
    uint TimeStamp;
    uint CodecFlag;
    uint Padding;
} MusxHeader <read=Str("MUSX hc=%#010x platform=%c%c%c%c size=%u", Hashcode, Platform[0], Platform[1], Platform[2], Platform[3], FileSize)>;

typedef struct
{
    uint Offset <format=hex>;
    uint Size <format=hex>;
} MusxEntry <read=Str("offset=%#x size=%#x", Offset, Size)>;

typedef struct
{
    uint MemorySlotCount;
    uint MemorySlotOffset <format=hex>;
    uint SoundBankCount;
    uint SoundBankOffset <format=hex>;
} ProjectOffsets <read=Str("memSlots=%u at %#x soundbanks=%u at %#x", MemorySlotCount, MemorySlotOffset, SoundBankCount, SoundBankOffset)>;

typedef struct
{
    int StereoStreamCount;
    int MonoStreamCount;
    int ProjectCode;
    int Unknown;
} ProjectFlags;

typedef struct
{
    uint SlotNumber;
    uint MemorySize;
    uint Quantity;
} MemorySlot <read=Str("slot=%u size=%u quantity=%u", SlotNumber, MemorySize, Quantity)>;

typedef struct
{
    uint Hashcode <format=hex>;
    uint SlotNumber;
} SoundBankSlot <read=Str("hc=%#010x slot=%u", Hashcode, SlotNumber)>;

SetBackColor(cLtPurple);
MusxHeader header;

if (header.Magic != "MUSX")
{
    Warning("File is not a valid MUSX file. Template stopped.");
    return -1;
}

local uint PayloadStart = 32;
local uint PayloadSize = header.FileSize - PayloadStart;
local int PayloadBigEndian = 0;

// __ProjectDetails.SFX is written via BindXFile(..., new[] { ProjectDetails.pdf }).
// That means the MUSX header is followed by one offset/size entry, then padding, then payload.
FSeek(32);
SetBackColor(cGreen);
MusxEntry ProjectDetailsEntryLE;

if (ProjectDetailsEntryLE.Offset >= 40 &&
    ProjectDetailsEntryLE.Size > 0 &&
    ProjectDetailsEntryLE.Offset < header.FileSize &&
    ProjectDetailsEntryLE.Offset + ProjectDetailsEntryLE.Size <= header.FileSize)
{
    PayloadStart = ProjectDetailsEntryLE.Offset;
    PayloadSize = ProjectDetailsEntryLE.Size;
}
else
{
    // GameCube and other big-endian outputs store the MUSX entry in platform endian.
    BigEndian();
    FSeek(32);
    MusxEntry ProjectDetailsEntryBE;

    if (ProjectDetailsEntryBE.Offset >= 40 &&
        ProjectDetailsEntryBE.Size > 0 &&
        ProjectDetailsEntryBE.Offset < header.FileSize &&
        ProjectDetailsEntryBE.Offset + ProjectDetailsEntryBE.Size <= header.FileSize)
    {
        PayloadStart = ProjectDetailsEntryBE.Offset;
        PayloadSize = ProjectDetailsEntryBE.Size;
        PayloadBigEndian = 1;
    }
    else
    {
        // Fallback for a raw/direct ProjectDetails payload after the 32-byte MUSX header.
        LittleEndian();
        PayloadStart = 32;
        PayloadSize = header.FileSize - PayloadStart;
    }
}

if (PayloadBigEndian)
    BigEndian();
else
    LittleEndian();

FSeek(PayloadStart);
SetBackColor(cBlue);
ProjectOffsets Offsets;

if (Offsets.MemorySlotOffset >= PayloadSize ||
    Offsets.SoundBankOffset >= PayloadSize ||
    Offsets.MemorySlotOffset + (Offsets.MemorySlotCount * 12) > PayloadSize ||
    Offsets.SoundBankOffset + (Offsets.SoundBankCount * 8) > PayloadSize)
{
    Warning("ProjectDetails offsets are outside the payload. Template stopped.");
    return -1;
}

FSeek(PayloadStart + 32);
SetBackColor(cDkRed);
ProjectFlags Flags;

FSeek(PayloadStart + Offsets.MemorySlotOffset);
SetBackColor(cLtBlue);
MemorySlot MemorySlots[Offsets.MemorySlotCount] <optimize=false>;

FSeek(PayloadStart + Offsets.SoundBankOffset);
SetBackColor(cAqua);
SoundBankSlot SoundBanks[Offsets.SoundBankCount] <optimize=false>;
