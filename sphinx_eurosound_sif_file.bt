//------------------------------------------------
//--- 010 Editor Binary Template
//
//      File: SphinxEuroSoundSIFFile.bt
//   Authors: jmarti856
//   Version: 1.1
//   Purpose: Parse separated EuroSound sample info chunks.
//  Category: Audio
// File Mask: *.sif
//
// Notes:
// - This template is for separated SIF sample info chunks, not final MUSX soundbank files.
// - The file starts directly with the sample count and SampleInfo array.
// - SampleInfo Duration is always little endian.
// - Change fileIsBigEndian to 1 if this chunk was exported in big endian.
//------------------------------------------------

//*===============================================================================================
//* GLOBALS
//*===============================================================================================
local int fileIsBigEndian = 0;

const uint SAMPLE_INFO_ENTRY_SIZE = 0x28;

//*===============================================================================================
//* STRUCTS
//*===============================================================================================
if(fileIsBigEndian)
    BigEndian();
else
    LittleEndian();

typedef struct
{
    uint Flags<format=hex>;

    uint Address<format=hex>;
    uint AudioDataSize<format=hex>;

    uint Frequency;
    uint RealSize<format=hex>;

    uint NumChannels;
    uint Bits;

    uint PSI<format=hex>;
    uint LoopOffset<format=hex>;

    // Always little endian.
    if(fileIsBigEndian)
        LittleEndian();

    uint Duration;

    if(fileIsBigEndian)
        BigEndian();

} SampleInfoEntry;

//*===============================================================================================
//* READ SAMPLE INFO CHUNK
//*===============================================================================================
SetBackColor(cLtGreen);

local uint totalSamples = ReadUInt(FTell());
FSkip(4);

if(totalSamples > ((FileSize() - 4) / SAMPLE_INFO_ENTRY_SIZE))
{
    Warning("Invalid SampleInfo count.");
    return -1;
}

local uint sampleIndex;

for(sampleIndex = 0; sampleIndex < totalSamples; sampleIndex++)
{
    SetBackColor(cLtGreen);
    SampleInfoEntry SampleInfo;
}