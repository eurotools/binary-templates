//------------------------------------------------
//--- 010 Editor Binary Template
//
//      File: spyro_sfx_streamdata.bt
//   Purpose: Parse EuroSound __Streamdata.SFX files generated by EuroSoundRedux.
// File Mask: *__streamdata.sfx
//  ID Bytes: 4D 55 53 58
//------------------------------------------------

LittleEndian();

typedef struct
{
    char Magic[4];
    uint Hashcode <format=hex>;
    uint FileVersion;
    uint FileSize <format=hex>;
    char Platform[4];
    uint TimeStamp;
    uint CodecFlag;
    uint Padding;
} MusxHeader <read=Str("MUSX hc=%#010x platform=%c%c%c%c size=%u", Hashcode, Platform[0], Platform[1], Platform[2], Platform[3], FileSize)>;

typedef struct
{
    uint Offset <format=hex>;
    uint Size <format=hex>;
} MusxEntry <read=Str("offset=%#x size=%#x", Offset, Size)>;

typedef struct
{
    uint StreamHeaderOffset <format=hex>;
} StreamLookup <read=Str("stream header offset=%#x", StreamHeaderOffset)>;

enum <uint> MarkerType
{
    Jump = 0,
    Pause = 5,
    Loop = 6,
    Goto = 7,
    End = 9,
    Start = 10
};

typedef struct
{
    int Name;
    uint Position;
    MarkerType Type;
    uint LoopStart;
    uint LoopMarkerCount;
    uint MarkerPosition;
} StartMarker <read=Str("name=%d pos=%u type=%s markerPos=%u", Name, Position, EnumToString(Type), MarkerPosition)>;

typedef struct
{
    int Name;
    uint Position;
    MarkerType Type;
    uint LoopStart;
    uint LoopMarkerCount;
} Marker <read=Str("name=%d pos=%u type=%s", Name, Position, EnumToString(Type))>;

typedef struct
{
    uint StartMarkerCount;
    uint MarkerCount;
    uint StartMarkerOffset <format=hex>;
    uint MarkerOffset <format=hex>;
    uint BaseVolume;

    local uint markerBase = startof(StartMarkerCount);

    FSeek(markerBase + StartMarkerOffset);
    StartMarker StartMarkers[StartMarkerCount] <optimize=false>;

    FSeek(markerBase + MarkerOffset);
    Marker Markers[MarkerCount] <optimize=false>;
} MarkerFile <read=Str("startMarkers=%u markers=%u volume=%u", StartMarkerCount, MarkerCount, BaseVolume), optimize=false>;

typedef struct
{
    uint MarkerSize <format=hex>;
    uint SampleDataOffset <format=hex>;
    uint SampleDataSize <format=hex>;

    local uint streamHeaderStart = startof(MarkerSize);
    FSeek(streamHeaderStart + 12);
    SetBackColor(cAqua);
    MarkerFile Markers;

    FSeek(BinData.Offset + SampleDataOffset);
    SetBackColor(cDkRed);
    ubyte SampleData[SampleDataSize];
} StreamEntry <read=Str("markerSize=%#x sampleOffset=%#x sampleSize=%#x", MarkerSize, SampleDataOffset, SampleDataSize), optimize=false>;

SetBackColor(cLtPurple);
MusxHeader header;

if (header.Magic != "MUSX")
{
    Warning("File is not a valid MUSX file. Template stopped.");
    return -1;
}

local int isGc = (header.Platform[0] == 'G' && header.Platform[1] == 'C');
if (isGc) BigEndian();

SetBackColor(cGreen);
MusxEntry LutData;
MusxEntry BinData;

if (LutData.Size > 0)
{
    FSeek(LutData.Offset);
    SetBackColor(cBlue);
    local uint StreamCount = LutData.Size / sizeof(StreamLookup);
    StreamLookup Lookup[StreamCount] <optimize=false>;

    local uint i;
    for (i = 0; i < StreamCount; i++)
    {
        FSeek(BinData.Offset + Lookup[i].StreamHeaderOffset);
        SetBackColor(cLtBlue);
        StreamEntry Stream;
    }
}
