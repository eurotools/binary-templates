//------------------------------------------------
//--- 010 Editor Binary Template
//
//      File: spyro_sfx_musics.bt
//   Purpose: Parse EuroSound music MUSX files generated by EuroSoundRedux.
// File Mask: _mus_*.sfx
//  ID Bytes: 4D 55 53 58
//------------------------------------------------

LittleEndian();

typedef struct
{
    char Magic[4];
    uint Hashcode <format=hex>;
    uint FileVersion;
    uint FileSize <format=hex>;
    char Platform[4];
    uint TimeStamp;
    uint CodecFlag;
    uint Padding;
} MusxHeader <read=Str("MUSX hc=%#010x platform=%c%c%c%c size=%u", Hashcode, Platform[0], Platform[1], Platform[2], Platform[3], FileSize)>;

typedef struct
{
    uint Offset <format=hex>;
    uint Size <format=hex>;
} MusxEntry <read=Str("offset=%#x size=%#x", Offset, Size)>;

enum <uint> MarkerType
{
    Jump = 0,
    Pause = 5,
    Loop = 6,
    Goto = 7,
    End = 9,
    Start = 10
};

typedef struct
{
    int Name;
    uint Position;
    MarkerType Type;
    uint LoopStart;
    uint LoopMarkerCount;
    uint MarkerPosition;
} StartMarker <read=Str("name=%d pos=%u type=%s markerPos=%u", Name, Position, EnumToString(Type), MarkerPosition)>;

typedef struct
{
    int Name;
    uint Position;
    MarkerType Type;
    uint LoopStart;
    uint LoopMarkerCount;
} Marker <read=Str("name=%d pos=%u type=%s", Name, Position, EnumToString(Type))>;

typedef struct
{
    uint StartMarkerCount;
    uint MarkerCount;
    uint StartMarkerOffset <format=hex>;
    uint MarkerOffset <format=hex>;
    uint BaseVolume;

    local uint markerBase = startof(StartMarkerCount);

    FSeek(markerBase + StartMarkerOffset);
    StartMarker StartMarkers[StartMarkerCount] <optimize=false>;

    FSeek(markerBase + MarkerOffset);
    Marker Markers[MarkerCount] <optimize=false>;
} MarkerFile <read=Str("startMarkers=%u markers=%u volume=%u", StartMarkerCount, MarkerCount, BaseVolume), optimize=false>;

SetBackColor(cLtPurple);
MusxHeader header;

if (header.Magic != "MUSX")
{
    Warning("File is not a valid MUSX file. Template stopped.");
    return -1;
}

local int isGc = (header.Platform[0] == 'G' && header.Platform[1] == 'C');
if (isGc) BigEndian();

SetBackColor(cGreen);
MusxEntry MarkerData;
MusxEntry StreamData;

if (MarkerData.Size > 0)
{
    FSeek(MarkerData.Offset);
    SetBackColor(cBlue);
    MarkerFile MusicMarkers;
}

if (StreamData.Size > 0)
{
    FSeek(StreamData.Offset);
    SetBackColor(cDkRed);
    ubyte MusicStream[StreamData.Size];
}
