//------------------------------------------------
//--- 010 Editor Binary Template
//
//      File: spyro_sfx_sounddetails.bt
//   Purpose: Parse EuroSound __SoundDetails.SFX files generated by EuroSoundRedux.
// File Mask: *__sounddetails.sfx
//  ID Bytes: 4D 55 53 58
//------------------------------------------------

LittleEndian();

typedef struct
{
    char Magic[4];
    uint Hashcode <format=hex>;
    uint FileVersion;
    uint FileSize <format=hex>;
    char Platform[4];
    uint TimeStamp;
    uint CodecFlag;
    uint Padding;
} MusxHeader <read=Str("MUSX compact hc=%#010x platform=%c%c%c%c size=%u", Hashcode, Platform[0], Platform[1], Platform[2], Platform[3], FileSize)>;

typedef struct
{
    uint FirstHashcode <format=hex>;
    uint LastHashcode <format=hex>;
} HashcodeRange <read=Str("first=%#010x last=%#010x", FirstHashcode, LastHashcode)>;

typedef struct
{
    ushort InnerRadius;
    ushort OuterRadius;
    float Duration;
    byte Looping;
    byte Tracking3d;
    byte SampleStreamed;
    byte Is3d;
} SoundDetails <read=Str("inner=%u outer=%u duration=%f loop=%d tracking=%d streamed=%d is3d=%d", InnerRadius, OuterRadius, Duration, Looping, Tracking3d, SampleStreamed, Is3d)>;

SetBackColor(cLtPurple);
MusxHeader header;

if (header.Magic != "MUSX")
{
    Warning("File is not a valid MUSX file. Template stopped.");
    return -1;
}

local int isGc = (header.Platform[0] == 'G' && header.Platform[1] == 'C');
if (isGc) BigEndian();

local uint PayloadStart = 32;
local uint PayloadSize = FileSize() - PayloadStart;

FSeek(PayloadStart);
SetBackColor(cGreen);
HashcodeRange Range;

SetBackColor(cBlue);
local uint EntryCount = (PayloadSize - sizeof(HashcodeRange)) / sizeof(SoundDetails);
SoundDetails Entries[EntryCount] <optimize=false>;
