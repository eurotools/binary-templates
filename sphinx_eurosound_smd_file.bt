//------------------------------------------------
//--- 010 Editor Binary Template
//
//      File: SphinxEuroSoundSMDFile.bt
//   Authors: jmarti856
//   Version: 1.1
//   Purpose: Parse separated EuroSound ADPCM state chunks.
//  Category: Audio
// File Mask: *.smd
//
// Notes:
// - This template is for separated SMD ADPCM state chunks.
// - Each entry is a packed 32-bit ADPCM runtime state.
// - The packed state is usually stored as 0xOOIIPPPP:
//      * PPPP = previous predicted PCM value
//      * II   = input buffer
//      * OO   = buffer step and ADPCM index
//------------------------------------------------

//*===============================================================================================
//* DISPLAY HELPERS
//*===============================================================================================
string ReadAdpcmState(uint state)
{
    int valpred      = state & 0xFFFF;
    uint inputBuffer = (state >> 16) & 0xFF;
    uint index       = (state >> 24) & 0x7F;
    uint bufferStep  = (state >> 31) & 0x01;

    if(valpred >= 0x8000)
        valpred -= 0x10000;

    return Str("valpred=%d, input=0x%02X, index=%u, step=%u", valpred, inputBuffer, index, bufferStep);
}

//*===============================================================================================
//* STRUCTS
//*===============================================================================================
LittleEndian();

typedef struct
{
    uint State<format=hex, read=ReadAdpcmState>;

} AdpcmState;

//*===============================================================================================
//* READ STATE CHUNK
//*===============================================================================================
if(FileSize() % 4 != 0)
{
    Warning("Invalid SMD size. File size is not aligned to 4 bytes.");
    return -1;
}

local uint stateCount = FileSize() / 4;
local uint stateIndex;

for(stateIndex = 0; stateIndex < stateCount; stateIndex++)
{
    SetBackColor(cLtGreen);
    AdpcmState State;
}